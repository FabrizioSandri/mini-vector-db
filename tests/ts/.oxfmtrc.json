{
    "$schema": "./node_modules/oxfmt/configuration_schema.json",
    "ignorePatterns": ["**/dist/**", "**/build/**", "**/node_modules/**", "**/.git/**"],
    "printWidth": 120,
    "tabWidth": 4,
    "sortImports": true,
    "sortTailwindcss": true,
    "singleQuote": true,
    "quoteProps": "consistent"
}
